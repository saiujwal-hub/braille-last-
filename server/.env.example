# Set to a fine-tuned YOLO weights file to use the trained cell detector.
BB_YOLO_WEIGHTS=
# 1 = enable the optional Real-ESRGAN enhancer (blurry photos only).
BB_ESRGAN_ENABLED=true
BB_ESRGAN_WEIGHTS=weights/RealESRGAN_x4plus.pth
# 1 = enable offline Coqui TTS.
BB_TTS_ENABLED=true
BB_TTS_MODEL=tts_models/en/ljspeech/vits
# 0 = skip background model loading at startup (tests/CI).
BB_PRELOAD=true
# LAN binding.
BB_HOST=0.0.0.0
BB_PORT=8000
